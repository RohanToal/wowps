# Pinned upstream versions.
#
# setup and update build EXACTLY these commits, so the server only changes when
# this file changes. Both commits below were merged from upstream's
# test-staging branch on the same day and are known to build together.
#
# To try newer upstream code, run `./update.sh --latest` (or
# `.\update.ps1 -Latest`). It rewrites the commits below. If the new build
# fails, it puts the old source back, and the server keeps running on the old
# images. To go back to the pins in this repo: `git checkout versions.env`, then
# run update again.

# AzerothCore, Playerbot fork. The normal AzerothCore repo does NOT work with
# mod-playerbots.
AC_REPO=https://github.com/mod-playerbots/azerothcore-wotlk.git
AC_BRANCH=Playerbot
AC_COMMIT=93333d6a9eb00fdf0179adde30da3c17618207d6

# mod-playerbots module
PLAYERBOTS_REPO=https://github.com/mod-playerbots/mod-playerbots.git
PLAYERBOTS_BRANCH=master
PLAYERBOTS_COMMIT=05a1f6fceb8a32aa879b13f5f48934c6e46a774c
