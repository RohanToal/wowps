# Server settings.
#
# setup copies this file to `.env` and fills in a random database password.
# Edit `.env` (not this file), then run stop + start for changes to apply.
#
# Format: KEY=value, one per line, no spaces around "=". Quotes are not needed,
# even when the value has spaces.

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------

# MySQL root password. setup replaces `change-me` with a random one.
# Use letters and numbers only (`;` and `$` break the server config).
# Only takes effect when the database is FIRST created. Changing it later
# won't change the real password. See "Changing the database password" in the
# README.
DB_ROOT_PASSWORD=change-me

# Port for connecting a DB tool (HeidiSQL, DBeaver...) from THIS computer only.
# Change it if something else on your PC already uses 3306.
DB_PORT=3306

# ----------------------------------------------------------------------------
# Realm / network
# ----------------------------------------------------------------------------

# Name shown in the realm list.
REALM_NAME=AzerothCore Playerbots

# The address game clients connect to after logging in. This must be an
# address the PLAYERS can reach:
#   127.0.0.1      -> only you, playing on this same computer (default)
#   192.168.x.x    -> this computer's LAN IP, for players on your home network
#                     (also works for you on this computer)
#   your public IP -> players over the internet (needs port forwarding of
#                     AUTH_PORT and WORLD_PORT on your router)
REALM_ADDRESS=127.0.0.1

# Ports the server listens on. The defaults are what the 3.3.5a client expects
# for login (3724). Only change them if you know you need to.
AUTH_PORT=3724
WORLD_PORT=8085

# Server time zone (affects daily quest resets, etc.), e.g. Europe/London,
# America/New_York. List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC

# ----------------------------------------------------------------------------
# Bots (mod-playerbots)
# ----------------------------------------------------------------------------

# 1 = random bots log in and roam the world. 0 = no random bots (you can still
# add bots to your own group with commands).
BOTS_ENABLED=1

# How many random bots are online. The server picks a number between MIN and
# MAX. Each bot uses CPU and memory. 100-200 is light; 500+ needs a strong PC.
# The first start after raising these takes a while because new bot characters
# get created.
BOTS_MIN=100
BOTS_MAX=200

# Level range of random bots.
BOTS_MIN_LEVEL=1
BOTS_MAX_LEVEL=80

# How many bots one player can control at the same time (.playerbots bot add,
# addclass, ...).
BOTS_PER_PLAYER=40

# 1 = random bots only log in while a real player is online (saves CPU when
# nobody is playing). 0 = bots are always online.
BOTS_ONLY_WITH_PLAYERS=0

# ----------------------------------------------------------------------------
# Backups
# ----------------------------------------------------------------------------

# How many backups to keep in ./backups (older ones are deleted). 0 = keep all.
BACKUP_KEEP=10

# ----------------------------------------------------------------------------
# Build (only matters for setup and update)
# ----------------------------------------------------------------------------

# How many files to compile at the same time. Leave empty to choose
# automatically from the CPU and memory Docker has (about 2 GB per job). If the
# build fails with "Killed" or "signal 9", set a smaller number such as 2.
BUILD_JOBS=

# User/group IDs the server runs as inside the containers. setup sets these
# automatically on Linux so the config/ and logs/ folders stay editable by
# you. On Windows and macOS leave them at 1000.
DOCKER_USER_ID=1000
DOCKER_GROUP_ID=1000

# ----------------------------------------------------------------------------
# Any other server option
# ----------------------------------------------------------------------------
# Every option in config/worldserver.conf or
# config/modules/playerbots.conf.dist can be set here: take the option name,
# put "AC_" in front, write it in UPPER_SNAKE_CASE, e.g.
#   Rate.XP.Kill = 1            ->  AC_RATE_XP_KILL=3
#   Playerbots.RandomBotJoinBG  ->  AC_PLAYERBOTS_RANDOM_BOT_JOIN_BG=0
# Settings here override the .conf files.
